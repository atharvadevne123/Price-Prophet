    given-names: "Atharva"
    email: "devneatharva@gmail.com"
repository-code: "https://github.com/atharvadevne123/Price-Prophet"
license: MIT
version: "1.0.0"
date-released: "2024-01-15"
keywords:
  - pricing
  - machine-learning
  - ensemble
  - fastapi
  - xgboost
  - lightgbm
  - faiss
  - drift-detection
